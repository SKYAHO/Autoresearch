# ============================================================================
# Feast Feature Store 환경 변수 (.env)
# 이 파일을 복사해서 .env 로 만들고 실제 값을 입력하세요:
#   cp .env.example .env
# ============================================================================

# GCP 서비스 계정 키 JSON 파일 경로
# GOOGLE_APPLICATION_CREDENTIALS=./keys/service-account.json

# ----------------------------------------------------------------------------
# Feast 환경 분리 (prod/dev, #399)
# ----------------------------------------------------------------------------
# AUTORESEARCH_ENV: 이 실행이 속한 환경(prod|dev). 미설정 시 prod 로 안전하게
#   해석됩니다. 오토리서치 에이전트의 실험은 dev(오프라인 전용: apply + BigQuery
#   PIT 학습·평가)로 두고, 온라인 서빙(Redis)·materialize 는 prod 만 합니다.
#   dev 는 registry(GCS_REGISTRY_PATH)·offline(BQ_DATASET)만 분리하면 됩니다.
# FEAST_ONLINE_FULL_SCAN_FOR_DELETION: apply 시 online store(Redis) 고아 키
#   삭제 스캔 여부. dev=false 면 apply 가 Redis 에 접속하지 않아 dev registry
#   apply 가 prod Redis 를 건드리지 않습니다. 배포가 명시하면 그 값이 우선입니다.
#   Python 경로(materialize·서빙·검증 스크립트)는 bootstrap 이 미설정 시
#   AUTORESEARCH_ENV 에서 파생해 채우므로 비워 둬도 됩니다. 다만 bare `feast`
#   CLI(로컬 `feast apply`/`materialize`)는 bootstrap 을 거치지 않아
#   feature_store.yaml 의 ${FEAST_ONLINE_FULL_SCAN_FOR_DELETION} 치환이 실패하므로,
#   로컬 절차를 위해 값을 명시해 둡니다(docs/guides/feast-gcp-setup.md 6단계).
#   빈 값(`FEAST_ONLINE_FULL_SCAN_FOR_DELETION=`)으로 두지 마십시오 — 미설정과
#   같게 취급되지만 shell 로 export 하면 yaml 이 null 을 받습니다.
# 주의: dev 로 실행할 때는 GCS_REGISTRY_PATH·BQ_DATASET·GCS_STAGING_LOCATION 을
#   dev 좌표로 함께 주입해야 저장 위치가 prod 와 분리됩니다.
AUTORESEARCH_ENV=prod
FEAST_ONLINE_FULL_SCAN_FOR_DELETION=true

# BigQuery (Offline Store)
# BQ_DATASET 은 Feast offline store(feature 계층) 전용 dataset 입니다.
# raw 계층(data_lake_*)은 CTR_TRAINING_BQ_RAW_DATASET(아래)이 가리키며,
# scripts/load_raw_to_bigquery.py 는 raw 계층 변수(CTR_TRAINING_BQ_PROJECT,
# CTR_TRAINING_BQ_RAW_DATASET)를 우선하고 project 는 GCP_PROJECT_ID 로
# fallback 합니다(#303). 두 dataset 변수를 섞어 쓰지 마세요.
GCP_PROJECT_ID=your-gcp-project-id
BQ_DATASET=feast_offline_store
BQ_LOCATION=asia-northeast3

# Vertex AI 임베딩(topic_similarity 계산용 text-multilingual-embedding-002, #206)
# 미설정 시 asia-northeast3으로 fallback — 나머지 인프라와 같은 리전 (#276).
GCP_LOCATION=asia-northeast3

# CTR 학습·추천 배치의 BigQuery dataset 계층 분리 (docs/guides/data-warehouse.md)
#   raw 계층      : data_lake_action_log, data_lake_youtube_trending_kr
#   feature/서빙  : user_static_feature, user_dynamic_feature, video_feature,
#                   user_category_similarity, user_recommendations
# 필수: CTR 학습·추천 배치가 사용할 GCP 프로젝트 ID를 설정하세요. 기본값은 없습니다.
CTR_TRAINING_BQ_PROJECT=
CTR_TRAINING_BQ_RAW_DATASET=data_lake_raw
CTR_TRAINING_BQ_DATASET=feast_offline_store

# 학습 spine 커버리지 가드 (#464). 둘 다 선택 — 미설정 시 아래 기본값이 쓰입니다.
# 기간 조회는 없는 파티션을 에러가 아니라 "행 없음"으로 돌려주므로, 요청 기간에
# 데이터 없는 날이 섞여도 조립이 조용히 성공했습니다. 이 가드가 그것을 실패로 바꿉니다.
# 근거·동작 계약 정본: docs/specs/2026-08-01-training-window-coverage-guard.md
#   MIN_COVERAGE_DAYS : 학습에 쓸 수 있는 최소 날짜 수. 정확도 하한이 아니라 사고 재발
#                       차단선입니다. CLI `--min-coverage-days 0` 으로 실행 단위 우회 가능
#                       (백필·좁은 구간 재현). 이 변수는 전역이라 배포 후 되돌리는 수단입니다.
#   MIN_ROWS_PER_DAY  : 이 행수 미만인 날은 "있음"으로 세지 않습니다. 붕괴일(240행)과
#                       정상일(12만~17만 행)을 가르는 값. CLI 플래그는 없습니다(전역만).
CTR_TRAINING_MIN_COVERAGE_DAYS=3
CTR_TRAINING_MIN_ROWS_PER_DAY=5000

# GCS Registry (FeatureView 메타데이터 저장 위치, registry.db 파일 경로)
# 학습 조립(build-features/run-pipeline)이 이 레지스트리를 **필수**로 읽는다 —
# #359 C2에서 DuckDB 재계산 경로가 제거돼 feast offline PIT가 유일 경로이므로,
# 미설정 시 build-features가 KeyError로 즉시 실패한다.
GCS_REGISTRY_PATH=gs://your-registry-bucket/registry.db

# GCS Staging (BigQuery materialize / get_historical_features 임시 저장소)
# 학습 조립도 이 staging을 **필수**로 쓴다(#359 C2, 위와 동일).
GCS_STAGING_LOCATION=gs://your-staging-bucket/

# 학습 데이터셋 스냅샷 게시 루트 (gs://bucket/prefix, #530).
# prod 재학습 경로에만 설정하십시오 — 실험·dev 파이프라인이 설정하면 by-date 포인터가
# 경합합니다. 미설정이면 조립은 로컬에만 저장하고 게시하지 않습니다.
TRAINING_SNAPSHOT_ROOT=

# Memorystore for Redis Cluster (Online Store)
# REDIS_HOST/REDIS_PORT: cluster discovery endpoint (infra terraform output)
# REDIS_TLS_CA_PATH: 서버 CA 번들 파일 경로. 없으면 아래 secret id로 가져온다.
# REDIS_CA_SECRET_ID: CA 번들이 있는 Secret Manager ID (GCP_PROJECT_ID 필요)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS_CA_PATH=
REDIS_CA_SECRET_ID=

# YouTube Data API v3 developer keys (쉼표 구분 복수; Key 무효화 대응)
YOUTUBE_API_KEYS=
# (폴백) 단수 Key — YOUTUBE_API_KEYS 가 우선.
YOUTUBE_API_KEY=

# GCS bucket name for the data lake (no gs:// prefix)
YOUTUBE_LAKE_BUCKET=

# Kaggle global parquet source for the public backfill command (gs:// or local path)
YOUTUBE_BACKFILL_SOURCE=

# Cloud Run 프록시 URL (1차: 미설정=비활성. 2차 PR에서 주입)
YOUTUBE_PROXY_URL=

# Action log public command defaults for local execution.
ACTION_LOG_VIRTUAL_USERS_PATH=
ACTION_LOG_OUTPUT_DIR=
ACTION_LOG_QUARANTINE_DIR=
ACTION_LOG_GENERATOR=rule_based
ACTION_LOG_CANDIDATES_PER_USER=24
ACTION_LOG_TARGET_CTR=0.02
ACTION_LOG_PERSONALIZED_RATIO=0.7
ACTION_LOG_POPULAR_RATIO=0.2
ACTION_LOG_EXPLORATION_RATIO=0.1
ACTION_LOG_MAX_CONCURRENCY=1
ACTION_LOG_CHUNK_SIZE=0
# 100 work 이하는 micro-work별 상세 timing, 초과 시 interval 집계 로그만 기록합니다.
# 숫자가 아니거나 허용 범위를 벗어난 telemetry 값은 아래 기본값으로 대체됩니다.
ACTION_LOG_TELEMETRY_DETAIL_MAX_WORK=100
# 대규모 실행 집계 주기(10~30초).
ACTION_LOG_TELEMETRY_INTERVAL_SEC=15
OPENROUTER_API_KEY=
OPENROUTER_TIMEOUT_SEC=60
OPENROUTER_MAX_RETRIES=2
# APITimeoutError는 중복 비용 위험을 제한하기 위해 별도 한도로 제한합니다.
OPENROUTER_TIMEOUT_MAX_RETRIES=1
OPENROUTER_RETRY_BACKOFF_BASE_SEC=1
OPENROUTER_RETRY_BACKOFF_MAX_SEC=30
# Optional provider routing. Empty values preserve OpenRouter defaults.
OPENROUTER_PROVIDER_SORT=
OPENROUTER_ALLOW_FALLBACKS=
OPENROUTER_REQUIRE_PARAMETERS=

# Agent Orchestration (실험용 FastAPI 채팅 저장)
# 기본값은 운영 계정이 `codex login`으로 로그인한 Codex CLI 공용 계정 모드입니다.
# OAuth 토큰은 이 파일에 넣지 마십시오. 서버의 운영 계정 Codex 홈/시크릿 볼륨에만 둡니다.
LLM_BACKEND=codex_cli
CODEX_CLI_PATH=codex
# OAuth 토큰 내용이 아닌, 전용 Codex 홈의 절대 경로만 설정합니다.
CODEX_HOME=/absolute/path/to/.agent-orchestration-codex
# 비우면 로그인된 Codex CLI의 기본 모델을 사용합니다.
CODEX_MODEL=
# 로컬 Codex CLI와 GKE Runner의 기본 실행 제한입니다. Runner는 ConfigMap에서 주입한
# `CODEX_RUNNER_TIMEOUT_SEC`과 `CODEX_TIMEOUT_SEC + 5 < CODEX_RUNNER_TIMEOUT_SEC`를 검증합니다.
CODEX_TIMEOUT_SEC=110
# GKE API는 private Codex Runner를 호출합니다. URL에는 시크릿을 넣지 마십시오.
CODEX_RUNNER_URL=
CODEX_RUNNER_TIMEOUT_SEC=120
# GKE 전용 API→Runner 내부 토큰입니다. ORCH_API_TOKEN과 다른 32자 이상 값이며
# Kubernetes Secret으로 API와 Runner에만 주입합니다.
ORCH_RUNNER_TOKEN=
# Runner 전용 동시 실행 상한입니다. 한도를 넘으면 즉시 503을 반환합니다.
RUNNER_MAX_CONCURRENCY=1
# /chat 호출자는 이 값과 같은 X-Orch-Token 헤더를 보내야 합니다(최소 32자).
ORCH_API_TOKEN=
# executor의 candidate 보고는 이 값과 같은 X-Orch-Executor-Token 헤더를 보내야 합니다.
# ORCH_API_TOKEN·ORCH_RUNNER_TOKEN과 다른 32자 이상 값만 허용합니다.
ORCH_EXECUTOR_API_TOKEN=
# Streamlit workbench가 Experiment API에 서버 측에서 연결할 때 사용합니다.
# 브라우저에 토큰을 노출하지 마십시오.
ORCH_UI_API_BASE_URL=http://127.0.0.1:8000
ORCH_UI_API_TOKEN=
# GKE init container 전용 값입니다. 시크릿 원문·완성 DB URL은 넣지 마십시오.
ORCH_DB_PASSWORD_SECRET_ID=
ORCH_DB_HOST=
ORCH_DB_NAME=
ORCH_DB_USER=
ORCH_RUNTIME_DIR=
ORCH_CODEX_AUTH_SECRET_ID=
# 향후 API 결제 전환용 설정: LLM_BACKEND=openai일 때만 OPENAI_API_KEY가 필수입니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.3-codex-spark
OPENAI_MAX_TOKENS=1024
OPENAI_TIMEOUT_SEC=60
ORCH_DATABASE_URL=postgresql://orch_user:orch_password@localhost:5432/orch_orchestration
ORCH_DB_CONNECT_TIMEOUT_SEC=10
ORCH_INTERACTIONS_TABLE=chat_interactions

# --- Auto Research 이슈 발행 (#516) ---
# `issues: write` 전용 GitHub 자격입니다. repo 스코프 토큰을 넣지 마십시오.
# gh CLI에 GH_TOKEN으로 전달됩니다.
ORCH_GITHUB_TOKEN=
# 발행 대상 저장소. gh가 돌려준 이슈 URL을 이 값과 대조합니다.
ORCH_GITHUB_REPOSITORY=SKYAHO/Autoresearch
# API baseline reader 전용 GitHub App 좌표입니다. Contents read만 허용하고 private key는
# read-only Secret volume 경로로 전달합니다.
ORCH_BASELINE_GITHUB_APP_ID=
ORCH_BASELINE_GITHUB_APP_INSTALLATION_ID=
ORCH_BASELINE_GITHUB_APP_PRIVATE_KEY_PATH=
# gh 서브프로세스 실행 상한(초).
ORCH_GH_TIMEOUT_SEC=30
# 일일 발행 상한. 초과하면 429를 반환합니다.
ORCH_ISSUE_DAILY_LIMIT=20
# ORCH_EXPERIMENT_DATASET_SOURCE와 ORCH_EXPERIMENT_TRAINING_CONFIG_REF는 #570에서
# 제거했습니다. 실행 설정을 이슈 본문에 복사하지 않으므로 서버가 읽지 않습니다.
# 배포 환경에 남아 있어도 무시되며, 지우셔도 됩니다.

# --- Experiment branch Job launcher 설정 (#546) ---
# launcher가 PostgreSQL 선점과 Kubernetes Job 생성에 사용하는 값입니다.
# executor image는 tag가 아니라 `@sha256:<64자리 digest>`로만 설정합니다.
ORCH_JOB_NAMESPACE=
ORCH_EXECUTOR_IMAGE=
ORCH_EXECUTOR_SERVICE_ACCOUNT=
# infra admission이 허용하는 GKE node pool 이름을 명시합니다. 기본값은 없으며
# nodeSelector와 `workload=<node pool>:NoSchedule` toleration에 함께 사용됩니다.
ORCH_EXECUTOR_NODE_POOL=
# 아래 값은 Kubernetes Secret의 이름과 GitHub App 공개 ID 좌표입니다. private key 원문을
# 환경 변수에 넣지 마십시오. private key는 initContainer에만 Secret volume으로 mount합니다.
ORCH_GITHUB_APP_SECRET_NAME=autoresearch-experiment-branch-writer-app
ORCH_GITHUB_APP_ID=
ORCH_GITHUB_APP_INSTALLATION_ID=
# 전용 namespace에서 동시에 실행할 executor Job 전역 상한입니다.
#
# 이 값은 혼자 정해지지 않습니다 — namespace ResourceQuota(`count/jobs.batch`, `pods`,
# requests/limits)와 batch-od 노드 용량이 같은 수를 받쳐 줘야 합니다. `count/jobs.batch`
# 자리가 없으면 Job 생성이 403으로 거부되고, 그 시점에는 이미 DB에 RUNNING으로 커밋돼
# 다음 launcher tick이 같은 이름으로 복구할 때까지 "실행 중인데 Job이 없는" 상태가
# 남습니다. 완료 Job도 아래 TTL 동안 세므로 hard ceiling과 동시성 값이 같으면 완료 직후
# tick에서 이 복구 경로를 탈 수 있습니다. 초기 배포는 canary 계약대로 2를 유지하고,
# infra #625 dev/admin 적용과 2건 canary가 끝난 뒤 별도 GitOps PR에서만 5로 올립니다.
# 반대로 requests/limits가 부족하면 Job은 생기지만 Pod가 `FailedCreate`로 막히므로 canary가
# 이 계약을 먼저 검증해야 합니다.
# 정본은 인프라입니다: SKYAHO/Autoresearch-infra의 experiment_jobs.tf와 launcher CronJob.
ORCH_MAX_CONCURRENT_EXPERIMENTS=2
# Phase 2 executor가 candidate SHA를 내부 API에 보고할 URL과 Secret 이름입니다.
# 실제 Secret과 release 주입은 Autoresearch-infra의 Stage 7 범위입니다.
ORCH_EXECUTOR_API_URL=
ORCH_EXECUTOR_API_TOKEN_SECRET_NAME=
# executor 전용 Codex 인증 Secret 이름과 Pod별 workspace emptyDir 상한입니다.
# Infra가 Secret과 auth.json key를 먼저 생성한 뒤 새 launcher 설정·이미지를 배포합니다.
# 롤백 시에는 이전 이미지와 ORCH_CODEX_HOME_PVC_NAME 설정을 함께 복원합니다.
ORCH_CODEX_HOME_SECRET_NAME=
ORCH_EXECUTOR_WORKSPACE_SIZE_LIMIT=8Gi
# executor Job 전체 상한과 그 안에서 Codex worker에 배정할 실행 상한(초)입니다.
# Codex 상한은 Job 전체 상한보다 작아야 하며 나머지 시간은 clone·학습·검증·push에 사용합니다.
#
# Job 상한을 크게 잡아도 LLM 비용은 ORCH_CODEX_TIMEOUT_SEC이 따로 막습니다 — 상한을
# 늘리는 실제 비용은 노드 점유입니다. 초기 canary 상한은 2이며, 후속 GitOps PR에서
# 5로 올린 뒤에는 멈춘 Pod 하나가 이 시간만큼 다섯 슬롯 중 하나를 붙잡습니다.
ORCH_ACTIVE_DEADLINE_SEC=60000
ORCH_CODEX_TIMEOUT_SEC=6000
# 완료 Job 보존 시간(초)입니다. 1분 launcher가 Failed Job을 놓치지 않도록 최소 두 tick인
# 120초를 보존합니다. 장애 smoke에서는 증거 수집을 위해 더 늘릴 수 있습니다.
ORCH_TTL_AFTER_FINISHED_SEC=120
# #574 데모 스코프 단일 파드 학습 — 같은 Pod가 baseline(Codex 실행 전)과
# candidate(push 후) 학습을 순서대로 실행합니다.
#
# ORCH_TRAINING_DATASET_URI가 이 기능의 on/off 스위치입니다. **비워 두면 학습을
# 건너뛰고** Phase 2의 기존 경로(clone → Codex → 검증 → push)만 돕니다.
#
# 값은 게시된 스냅샷의 by-hash prefix입니다(#530). 마지막 segment가 CSV 내용의
# SHA-256이며, executor가 내려받은 바이트를 그 값과 대조합니다(#605) — 다운로드는
# workspace 코드가 수행하지만 그 경로는 Codex의 허용 범위(src/**)라, baseline과
# candidate가 다른 데이터로 학습하는 사고를 이 검증이 막습니다. 형식이 어긋나면
# launcher가 Job을 만들기 전에 거부합니다.
#   gs://<bucket>/<prefix>/by-hash/<64자리 sha256>/
#
# Pod가 이 객체를 읽으려면 experiment-job GSA에 스냅샷 root read 권한이 필요합니다
# (roles/storage.objectViewer). 권한 없이 채우면 다운로드 단계에서 실패합니다.
#
# 조립(build-features)은 이 Pod에서 하지 않습니다. feast group이 executor 이미지에
# 없고 pyproject.toml이 feast와 dev를 conflicts로 선언해 재빌드로도 넣을 수 없습니다.
# 조립은 파드 밖에서 한 번 돌려 스냅샷으로 게시하고, 그 URI를 여기에 지정합니다.
ORCH_TRAINING_DATASET_URI=
# 학습 1회(seed 하나)의 상한(초)입니다. 3일 창·494k행·1 CPU 기준 실측 19.5초이며,
# 12일 창에서는 67.8초입니다(소요는 데이터 크기에 거의 선형). seed 수만큼 반복하므로
# ORCH_ACTIVE_DEADLINE_SEC 안에 (1회 × seed 수 × 2조건)이 들어가야 합니다.
ORCH_TRAINING_TIMEOUT_SEC=1800
# 스냅샷 1회 다운로드의 상한(초)입니다. baseline 단계에서 한 번만 받고 candidate 단계와
# Job 재시도는 이미 받아둔 파일을 재사용합니다(3일 창 CSV 기준 약 85MB).
ORCH_TRAINING_DOWNLOAD_TIMEOUT_SEC=600
# candidate가 pyproject.toml·uv.lock을 바꾼 경우에만 도는 uv sync의 상한(초)입니다.
# 의존성이 그대로면 실행하지 않습니다 — 데모 규모 candidate는 대부분 하이퍼파라미터만
# 바꾸므로 매번 동기화하면 deadline 예산만 축냅니다.
ORCH_UV_SYNC_TIMEOUT_SEC=900
# 학습이 MLflow run을 기록할 tracking server 좌표입니다(#624). 비워 두면 executor에
# 아무것도 붙지 않고, 학습은 Pod 로컬 file store로 떨어져 run이 Pod과 함께 사라집니다.
# 그러면 paired 비교(training_comparison.py)가 runs:/<run_id>/... 로 내려받을 artifact를
# 잃습니다.
#
# **이름이 갈리는 지점입니다.** launcher가 받는 이름은 ORCH_ 접두사가 붙은 이 변수지만,
# executor container에 내보내는 이름은 접두사 없는 MLFLOW_TRACKING_URI입니다(jobs.py).
# src/pipeline/train.py가 표준 이름으로 읽기 때문이며, 접두사를 붙여 내보내면 값이
# 전달돼도 학습은 그대로 로컬 file store에 기록합니다. 아래쪽 MLFLOW_TRACKING_URI는
# 이 저장소의 다른 실행 경로(학습·서빙 CLI)가 직접 읽는 별개 변수입니다.
ORCH_MLFLOW_TRACKING_URI=

# 로그 수집기(#559)의 Pod 로그 폴링 주기(초)입니다. 워크벤치가 5초 cursor polling을
# 하므로 이보다 크게 두면 체감 지연이 그만큼 늘어납니다 — 둘을 합쳐 최악 지연이
# 정해집니다.
#
# 수집기는 launcher와 별개인 상주 Deployment로 돌며, executor 컨테이너를 건드리지
# 않고 밖에서 Pod 로그를 읽습니다. credential 경계를 유지하려는 선택입니다.
ORCH_LOG_COLLECT_INTERVAL_SEC=5
# 실험 산출물(metrics.json·학습 산출물)을 남길 GCS 루트입니다. `gs://bucket[/prefix]`.
# 비어 있으면 게시하지 않습니다 — 다만 Pod의 /workspace는 emptyDir이라 TTL 후 통째로
# 사라지므로, 비워 두면 **측정한 것이 아무것도 남지 않습니다.** 학습을 켠 배포라면
# 함께 채우는 것이 정상입니다.
#
# executor는 이 루트 아래 experiments/<이슈번호>/<experiment_id>/ 로 씁니다.
# 대상 버킷의 experiment-job GSA 권한은 objectCreator+objectViewer이며 objectCreator는
# **기존 객체 교체를 허용하지 않습니다** — 게시된 결과는 같은 Pod의 에이전트도
# 덮어쓸 수 없습니다.
ORCH_EXPERIMENT_RESULTS_ROOT=

# --- Experiment branch executor 주입 좌표 (#546) ---
# 아래 값은 운영자가 직접 설정하지 않습니다. launcher가 DB의 봉인 좌표와 고정 volume
# 경로를 executor Pod에 주입합니다. private key 경로는 token-minter initContainer에만,
# token 경로는 initContainer와 branch-bootstrap container에 전달됩니다.
ORCH_EXPERIMENT_ID=
ORCH_ISSUE_NUMBER=
ORCH_ISSUE_BRANCH=
ORCH_BASE_DEV_SHA=
ORCH_GITHUB_APP_PRIVATE_KEY_FILE=/var/run/secrets/github-app/private-key.pem
ORCH_GITHUB_TOKEN_FILE=/var/run/github-token/token

# Reranking serving API: local artifact mode
RERANK_MODEL_SOURCE=local
RERANK_FEATURE_COLUMNS_PATH=
RERANK_CATEGORICAL_COLUMNS_PATH=
RERANK_ONNX_MODEL_PATH=
RERANK_MANIFEST_PATH=
# local manifest의 sampling_rate < 1.0일 때만 설정하며, 1.0이면 비워 둡니다.
RERANK_CALIBRATION_MODEL_PATH=

# Reranking serving API: MLflow artifact mode
# 학습(train-model / run-pipeline)도 이 값을 읽는다. 비어 있으면 운영 학습은 원인이
# 드러나는 메시지로 즉시 중단한다(#406 — 예전에는 http://localhost:5000으로 조용히
# 넘어가 연결 오류로 죽었다). 실험은 --experiment <이름>을 주면 로컬 파일 스토어
# (프로젝트 루트의 mlruns/)를 기본값으로 쓰고 registry 이름도 prod와 분리된다.
# 이 기본값은 실행 위치와 무관한 절대 경로다 — CWD 상대면 하위 디렉토리에서 돌릴 때
# 실험 이력이 갈린다(#444).
MLFLOW_TRACKING_URI=
RERANK_MLFLOW_RUN_ID=
